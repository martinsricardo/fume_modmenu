doallEbSpawn()
{
	if(self isHost()) {
		self.ebtimer = "Point Two EB";
		self.pers["killcamtime"] = 2;
		self.pers["ebdelay"] = .124;
		self.pers["timerchanged"] = "ebfixed";
	} else {
		self.ebtimer = "Point Three EB";
		self.pers["killcamtime"] = 3;
		self.pers["ebdelay"] = .131;
		self.pers["timerchanged"] = "ebfixed";
	}
}

