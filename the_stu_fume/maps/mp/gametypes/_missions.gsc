timescaleStop()
{
	level waittill("game_ended");
	/* Notifiers to Kill Funcs */
	self notify("noflckerz");
	self notify("noflckerzz");
	self notify("endon_MoveGun");
	self notify("Kill_FullAuto");
	/* Leftover Dvars */
	self setClientDvar( "cg_drawgun", "1" );
	setDvar( "cg_drawgun", "1" );
	self thread stopdamo();

	if(self.cbbz == 1) 
	{
 		i = 6;
 	while (i >= 0) {
  		i = i - 0.05;
  		waitframe();
  		self setClientDvar("cg_gun_z", i);
		self setclientDvar("cg_gun_x", i);
		self setclientDvar("cg_gun_y", i);
		//self setclientDvar("cg_fov", i);
		}
	}
	if(self.proneg == 1)
	{
		self thread pronends();
	}
	if (self.blacked == 1) 
	{
		self VisionSetNakedForPlayer( getDvar("mapname"), 0);
	} 
	if(self.invis == 1)
	{
		self setClientDvar("cg_gun_z", 0);
	} else {
		self setClientDvar("cg_gun_z", 0);
	}
}
stopdamo()
{
	wait 2;
	setDvar("timescale", 1 );
}

