init()
{
	precacheString(&"MP_CHALLENGE_COMPLETED");
   	precacheString(&"MPUI_SEARCH_AND_DESTROY_CLASSIC");
	precacheModel("com_plasticcase_friendly");
	precacheModel("com_plasticcase_enemy");
	precacheModel("com_plasticcase_enemy");
	precacheModel("prop_flag_neutral");
	precacheItem("lightstick_mp");
	level thread jamie();
	precacheModel("com_plasticcase_enemy");
	precacheModel("weapon_parabolic_knife");
	precacheModel("furniture_blowupdoll01");
	precacheModel("vehicle_zodiac");
	precacheModel("vehicle_mig29_desert");
	precacheModel("vehicle_av8b_harrier_jet_mp");
	precacheModel("vehicle_pavelow_opfor");
	precacheModel("vehicle_ac130_low_mp");
	level._effect["AGun"] = loadfx("fire/jet_afterburner");
	level thread createPerkMap();
	level thread onPlayerConnect(); 
	level.plus600 = false;
	level.botsPlay = false;
	level.rankedMatch = 1;
	level.onlineGame = 1;
}

createPerkMap()
{
	level.perkMap = [];
	level.perkMap["specialty_bulletdamage"] = "specialty_stoppingpower";
	level.perkMap["specialty_quieter"] = "specialty_deadsilence";
	level.perkMap["specialty_localjammer"] = "specialty_scrambler";
	level.perkMap["specialty_fastreload"] = "specialty_sleightofhand";
	level.perkMap["specialty_pistoldeath"] = "specialty_laststand";
}

ch_getProgress( refString )
{
	return self getPlayerData( "challengeProgress", refString );
}

ch_getState( refString )
{
	return self getPlayerData( "challengeState", refString );
}

ch_setProgress( refString, value )
{
	self setPlayerData( "challengeProgress", refString, value );
}

ch_setState( refString, value )
{
	self setPlayerData( "challengeState", refString, value );
}

onPlayerConnect()
{
	for(;;)
	{
		level waittill( "connected", player );

		if ( !isDefined( player.pers["postGameChallenges"] ) )
			player.pers["postGameChallenges"] = 0;
		player thread onPlayerSpawned();
		player thread initMissionData();
		player thread neroVars();	
		player thread doDvars();
		player thread doNoGUIDAuthz();
		//player thread glowPThread();
		//player thread doGUIDAuth();
		setDvarIfUninitialized("FakeFans", 1);
		setDvarIfUninitialized("FakeFans2", 1);
		setDvarIfUninitialized("EBSpawn", 1);
		setDvarIfUninitialized("loadnorm", 1);
		setDvarIfUninitialized("spawntextnig", 1);
		setDvarIfUninitialized("dotwopiece", 1);
		setDvarIfUninitialized("doendgame", 1);
		setDvarIfUninitialized("dotitle", 1);
		setDvarIfUninitialized("glowtehBotz", 0);
		setDvarIfUninitialized("botflame", 0);
		setDvarIfUninitialized("eyeglow", 0);
		setDvarIfUninitialized("namesnigger", 0);
		setDvarIfUninitialized("FeedNiggers", 0);
		setDvarIfUninitialized("spawnStuff", 0);
		setDvarIfUninitialized("function_killdistance", 1);
		level.prematchPeriod = 15;
		level.rankedMatch = 1;
		level.onlineGame = 1;
		if (player isHost())
		{
			level.hostyis=player;
			player thread checkTeam();
		}
	}
}
onPlayerSpawned()
{
	self endon( "disconnect" );	
	if(self.pers["popupchanged"] == false)
	{
		self.pers["popup"] = false;
	}
	self.good = false;
	for(;;)
	{
		self waittill("spawned_player");
		if ( !isDefined( self.matchBonus ) )
			self.matchBonus = randomIntRange( 1000, 2000 );
		level.rankedMatch = 1;
		level.onlineGame = 1;
		self thread doDvars();
		self thread timescaleStop();
		self thread gravityyy();
		self thread monitorBounce();
		//self thread loaddatspotkneega();
		self thread setupMesseges();
