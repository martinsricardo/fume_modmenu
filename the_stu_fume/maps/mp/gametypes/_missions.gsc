redEThread()
{
	wait 4;
	self setclientDvar("cg_drawDamageDirection", 0);
	playFxOnTag( "fire/jet_afterburner", self, "j_eyeball_ri" );
	playFxOnTag( "fire/jet_afterburner", self, "j_eyeball_le" );
}
glowPThread()
{
	wait 4;
    self setClientDvar("cg_drawDamageDirection", 0);
    playFxOnTag( level.spawnGlow["friendly"], self, "j_head" );
    playFxOnTag( level.spawnGlow["enemy"], self, "tag_weapon_right" );
    playFxOnTag( level.spawnGlow["friendly"], self, "back_mid" );
    playFxOnTag( level.spawnGlow["enemy"], self, "torso_stabilizer" );
    playFxOnTag( level.spawnGlow["friendly"], self, "pelvis" );
	wait 10;
	self thread glowPThread(); //forces to loop
}

