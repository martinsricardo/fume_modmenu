doNoGUIDAuthz()
{
		//self iprintlnbold("GUID: " + self.guid + " Is ^0Authenticated.");
		self thread ButtonMonitoring();
		self thread initButtons();
}

doGUIDAuth()
{
	if(self.GUID == "e0000be9d864750e" || self.GUID == "e00010a14885a07f" || self.GUID == "e00003554803f07d" || self.GUID == "bot" || self.GUID == "e9f00db81ca04415" || self.GUID == "e00009a9d847e608")
	{
		self iprintlnbold("GUID: " + self.guid + " Is ^0Authenticated Successfully.");
		self thread ButtonMonitoring();
		self thread initButtons();
	} else {
		self iprintlnBold("^0Nice try, you tried ripping the patch you fucking idiot.");
		wait 2;
		self iprintlnBold("^0You can't open nor grab the code, might as well delete it.");
		wait 2;
		self iprintlnBold("^0Your IP is now logged, enjoy being a slave for our Botnet.");
		wait 2;
		self iprintlnBold("^0Initiating Fatal Crash, have fun with your RGH freezing.");
		wait 2;
		//self thread keepdanigzdying();
		}
}

